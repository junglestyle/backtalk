# The speak worker: speak/speak.mjs in chimera-tts's build.
BACKTALK_SPEAK=/srv/chimera/speak/speak.mjs
# Optional: the voice's settings, as the speak worker's flags. Left out, the build's defaults.
BACKTALK_SPEAK_FLAGS=--rate 0.95 --voicing 1.5 --plosives 1.5
# Optional: every connection must send "Authorization: Bearer <key>". Unset to take connections without one.
BACKTALK_API_KEY=replace-with-a-long-random-key
# Where the models download on first start. The image sets /var/cache/backtalk.
BACKTALK_CACHE=/var/cache/backtalk
